---
import "../styles/global.css";
import { components } from "../data/components.js";
import { PILLARS, ANIMATIONS, pillarOf } from "../data/pillars.js";
import { withBase, stripBase } from "../lib/base.js";

const {
  title = "pura",
  description = "Native web components. Zero dependencies.",
  toc = [],
  layout = "docs",
} = Astro.props;
const path = stripBase(Astro.url.pathname);

// Active pillar = explicit prop (pillar pages, doc pages) or derived from the open
// component's category. Null on non-docs pages.
const activeSlug = path.startsWith("/docs/") ? path.slice("/docs/".length) : null;
const activeComp = activeSlug ? components.find((c) => c.slug === activeSlug) : null;
const activePillar = Astro.props.pillarKey || (activeComp ? pillarOf(activeComp.category)?.key : null);

// Sidebar shows only the active pillar's categories (all pillars if none active).
const sideCats = activePillar
  ? (PILLARS.find((p) => p.key === activePillar)?.categories || [])
  : PILLARS.flatMap((p) => p.categories);
const groups = sideCats
  .map((cat) => ({ cat, items: components.filter((c) => c.category === cat).sort((a, b) => a.title.localeCompare(b.title)) }))
  .filter((g) => g.items.length);

const nav = [
  { href: "/", label: "Home", key: "nav.home" },
  { href: "/templates", label: "Blocks", match: "/templates", key: "nav.blocks" },
  { href: "/theme", label: "Theme", match: "/theme", key: "nav.theme" },
];
const features = [
  { t: "Native Web Components", d: "Custom Elements + Shadow DOM. Works in React, Vue, Svelte or plain HTML.", href: "/docs/button" },
  { t: "Zero dependencies, zero build", d: "Just a script tag. No bundler, no framework lock-in.", href: "/" },
  { t: "Theme system", d: "57 brand presets + a full token editor. Restyle everything live.", href: "/theme" },
  { t: "Built-in i18n", d: "Every component ships 5 languages (EN/PT/FR/DE/IT). Switch live.", href: "/docs/calendar" },
  { t: "Agent-native", d: "Machine-readable affordances so AI agents can read & operate the UI.", href: "/docs/action" },
  { t: "Live inspector", d: "Click the bubble to hover, highlight and edit any element's attributes.", href: "/docs/button" },
];
const isDocs = layout === "docs";
const allItems = components.map((c) => ({ slug: c.slug, title: c.title, category: c.category }));
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — pura</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="stylesheet" href="/pura/tokens.css" />
    <script type="module" src="/pura/pura.js"></script>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={withBase("/")}>pura <small>web components</small></a>
      <nav class="mainnav">
        {nav.map((n) => (
          <a href={withBase(n.href)} data-i18n={n.key} class={(n.match ? path.startsWith(n.match) : path === "/") ? "on" : ""}>{n.label}</a>
        ))}
        <div class="dropdown">
          <button class:list={["ddtrigger", { on: path.startsWith("/docs") }]} type="button" aria-haspopup="true" data-i18n="nav.docs">Docs</button>
          <div class="ddpanel" role="menu">
            {PILLARS.map((p) => (
              <a href={withBase(`/docs/pillar/${p.key}`)} role="menuitem"><b>{p.label}</b><span>{p.categories.join(", ")}</span></a>
            ))}
            <a href={withBase(`/docs/pillar/${ANIMATIONS.key}`)} role="menuitem"><b>{ANIMATIONS.label}</b><span>Motion components</span></a>
          </div>
        </div>
        <div class="dropdown">
          <button class="ddtrigger" type="button" aria-haspopup="true" data-i18n="nav.features">Features</button>
          <div class="ddpanel" role="menu">
            {features.map((f) => (
              <a href={withBase(f.href)} role="menuitem"><b>{f.t}</b><span>{f.d}</span></a>
            ))}
          </div>
        </div>
      </nav>
      <div class="spacer"></div>
      <button class="search" id="searchbtn" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span data-i18n="search.ph">Search components…</span>
        <span class="k"><kbd>⌘</kbd><kbd>K</kbd></span>
      </button>
      <a class="stars" href="https://github.com" target="_blank" rel="noreferrer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.8-1.3-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.3-.5-1.5.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 5 18 5.3 18 5.3c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
        0
      </a>
      <select class="locale" id="locale" aria-label="Language">
        <option value="en">EN</option><option value="pt-BR">PT</option><option value="fr">FR</option><option value="de">DE</option><option value="it">IT</option>
      </select>
      <button class="iconbtn" id="theme" aria-label="Toggle dark mode" title="Toggle theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg>
      </button>
      <button class="newbtn" id="design" data-i18n="nav.theme">Theme</button>
    </header>

    <div class={`layout ${layout === "full" ? "full" : toc.length ? "" : "no-toc"}`}>
      {isDocs && (
        <aside class="side">
          <div class="pillarbar">
            {PILLARS.map((p) => (
              <a href={withBase(`/docs/pillar/${p.key}`)} class={activePillar === p.key ? "on" : ""}>{p.label}</a>
            ))}
            <a href={withBase(`/docs/pillar/${ANIMATIONS.key}`)} class={activePillar === ANIMATIONS.key ? "on" : ""}>{ANIMATIONS.label}</a>
          </div>
          <div class="group"><h4 data-i18n="side.start">Getting Started</h4>
            <a href={withBase("/")} aria-current={path === "/" ? "page" : undefined} data-i18n="side.intro">Introduction</a>
            <a href={withBase("/theme")} aria-current={path === "/theme" ? "page" : undefined} data-i18n="nav.theme">Theming</a>
          </div>
          {groups.map((g) => (
            <div class="group"><h4>{g.cat}</h4>
              {g.items.map((c) => (
                <a href={withBase(`/docs/${c.slug}`)} aria-current={path === `/docs/${c.slug}` ? "page" : undefined}>{c.title}</a>
              ))}
            </div>
          ))}
        </aside>
      )}
      <main><slot /></main>
      {isDocs && toc.length > 0 && (
        <nav class="toc">
          <h5 data-i18n="toc.title">On This Page</h5>
          {toc.map((t) => <a href={`#${t.id}`} data-toc={t.id}>{t.label}</a>)}
        </nav>
      )}
    </div>

    <dialog id="cmdk" class="cmdk">
      <div class="cmdk-in">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="cmdk-input" type="text" placeholder="Search components…" autocomplete="off" spellcheck="false" />
        <kbd>esc</kbd>
      </div>
      <div class="cmdk-list" id="cmdk-list">
        {allItems.map((c) => (
          <a class="cmdk-item" href={withBase(`/docs/${c.slug}`)} data-q={`${c.title} ${c.category}`.toLowerCase()}>
            <span>{c.title}</span><small>{c.category}</small>
          </a>
        ))}
      </div>
    </dialog>

    <pura-theme-designer id="designer"></pura-theme-designer>
    <pura-inspector position="bottom-left"></pura-inspector>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const saved = localStorage.getItem("pura-color-scheme");
        if (saved) root.dataset.theme = saved;
        document.getElementById("theme")?.addEventListener("click", () => {
          root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
          localStorage.setItem("pura-color-scheme", root.dataset.theme);
        });
        document.getElementById("design")?.addEventListener("click", () => document.getElementById("designer")?.toggle());

        // ---- command palette (search) ----
        const dlg = document.getElementById("cmdk");
        const input = document.getElementById("cmdk-input");
        const items = [...document.querySelectorAll(".cmdk-item")];
        let active = 0;
        const visible = () => items.filter((i) => !i.hidden);
        const setActive = (i) => { const v = visible(); active = Math.max(0, Math.min(i, v.length - 1)); v.forEach((el, j) => el.classList.toggle("on", j === active)); v[active]?.scrollIntoView({ block: "nearest" }); };
        const openCmdk = () => { dlg.showModal(); input.value = ""; filter(""); input.focus(); };
        const filter = (q) => { q = q.trim().toLowerCase(); items.forEach((i) => (i.hidden = q && !i.dataset.q.includes(q))); setActive(0); };
        input?.addEventListener("input", () => filter(input.value));
        input?.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
          else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
          else if (e.key === "Enter") { e.preventDefault(); const v = visible(); if (v[active]) location.href = v[active].href; }
        });
        document.getElementById("searchbtn")?.addEventListener("click", openCmdk);
        addEventListener("keydown", (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); openCmdk(); } });
        dlg?.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });

        // ---- chrome i18n (visible language switch) ----
        const T = {
          "nav.home": { en: "Home", "pt-BR": "Início", fr: "Accueil", de: "Start", it: "Home" },
          "nav.docs": { en: "Docs", "pt-BR": "Docs", fr: "Docs", de: "Doku", it: "Docs" },
          "nav.blocks": { en: "Blocks", "pt-BR": "Blocos", fr: "Blocs", de: "Blöcke", it: "Blocchi" },
          "nav.theme": { en: "Theme", "pt-BR": "Tema", fr: "Thème", de: "Theme", it: "Tema" },
          "nav.features": { en: "Features", "pt-BR": "Recursos", fr: "Fonctions", de: "Funktionen", it: "Funzioni" },
          "search.ph": { en: "Search components…", "pt-BR": "Buscar componentes…", fr: "Rechercher des composants…", de: "Komponenten suchen…", it: "Cerca componenti…" },
          "side.start": { en: "Getting Started", "pt-BR": "Começando", fr: "Démarrage", de: "Erste Schritte", it: "Per iniziare" },
          "side.intro": { en: "Introduction", "pt-BR": "Introdução", fr: "Introduction", de: "Einführung", it: "Introduzione" },
          "toc.title": { en: "On This Page", "pt-BR": "Nesta página", fr: "Sur cette page", de: "Auf dieser Seite", it: "In questa pagina" },
        };
        // pages contribute their own strings via window.__i18nExtra
        const dict = () => Object.assign({}, T, window.__i18nExtra || {});
        const applyChrome = (loc) => {
          const D = dict();
          document.querySelectorAll("[data-i18n]").forEach((el) => { const e = D[el.dataset.i18n]; if (e) el.textContent = e[loc] || e.en; });
          document.querySelectorAll("[data-i18n-html]").forEach((el) => { const e = D[el.dataset.i18nHtml]; if (e) el.innerHTML = e[loc] || e.en; });
          document.querySelectorAll("[data-i18n-ph]").forEach((el) => { const e = D[el.dataset.i18nPh]; if (e) { const v = e[loc] || e.en; el.setAttribute("placeholder", v); if ("placeholder" in el) el.placeholder = v; } });
          if (input) input.placeholder = (D["search.ph"][loc] || D["search.ph"].en);
        };
        const locale = document.getElementById("locale");
        const cur = localStorage.getItem("pura-locale") || "en";
        if (locale) {
          locale.value = cur;
          locale.addEventListener("change", () => import("/pura/i18n.js").then((m) => m.setLocale(locale.value)));
        }
        addEventListener("pura:locale", (e) => applyChrome(e.detail.locale));
        applyChrome(cur);

        // ---- TOC scrollspy ----
        const links = [...document.querySelectorAll("nav.toc a[data-toc]")];
        if (links.length) {
          const map = new Map(links.map((a) => [a.dataset.toc, a]));
          const io = new IntersectionObserver((es) => { es.forEach((en) => { if (en.isIntersecting) { links.forEach((l) => l.classList.remove("active")); map.get(en.target.id)?.classList.add("active"); } }); }, { rootMargin: "-10% 0px -80% 0px" });
          links.forEach((a) => { const el = document.getElementById(a.dataset.toc); if (el) io.observe(el); });
        }

        // ---- sidebar scroll persistence (full-page nav resets it otherwise) ----
        const side = document.querySelector("aside.side");
        if (side) {
          const KEY = "pura-side-scroll";
          const y = sessionStorage.getItem(KEY);
          if (y !== null) side.scrollTop = +y;
          let raf = 0;
          side.addEventListener("scroll", () => {
            if (raf) return;
            raf = requestAnimationFrame(() => { raf = 0; sessionStorage.setItem(KEY, side.scrollTop); });
          }, { passive: true });
          addEventListener("pagehide", () => sessionStorage.setItem(KEY, side.scrollTop));
        }
      })();
    </script>

    <style>
      .pillarbar { display: flex; flex-wrap: wrap; gap: .25rem; margin-bottom: 1.25rem; }
      .pillarbar a { font-size: .72rem; padding: .2rem .5rem; border: 1px solid var(--pura-border); border-radius: var(--pura-radius-sm); color: var(--pura-muted-fg); text-decoration: none; }
      .pillarbar a:hover { background: var(--pura-subtle); }
      .pillarbar a.on { background: var(--pura-fg); color: var(--pura-bg); border-color: var(--pura-fg); }
    </style>
  </body>
</html>
