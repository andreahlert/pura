---
import Doc from "../layouts/Doc.astro";
import { components } from "../data/components.js";
import { withBase } from "../lib/base.js";
const total = components.length;

const features = [
  { key: "f1", d: "M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.27 6.96 12 12.01l8.73-5.05 M12 22.08V12" },
  { key: "f2", d: "M13 2 3 14h9l-1 8 10-12h-9l1-8z" },
  { key: "f3", d: "M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5S12.5 5 12 2.5C11.5 5 10 7.4 8 9S5 13 5 15a7 7 0 0 0 7 7z" },
  { key: "f4", d: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M2 12h20 M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z" },
  { key: "f5", d: "M9 2v2 M15 2v2 M9 20v2 M15 20v2 M2 9h2 M2 15h2 M20 9h2 M20 15h2 M6 6h12v12H6z M9 9h6v6H9z" },
  { key: "f6", d: "M21 21l-4.35-4.35 M11 8v6 M8 11h6 M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z" },
];

const heroCode = `<script type="module" src="pura.js"></` + `script>

<pura-button>Get started</pura-button>
<pura-switch checked></pura-switch>
<pura-badge variant="success" dot>Live</pura-badge>`;

const frameworks = [
  { label: "React", lang: "jsx", code: `import "pura";

export default function App() {
  return <pura-button>Click me</pura-button>;
}` },
  { label: "Vue", lang: "vue", code: `<script setup>
import "pura";
</` + `script>

<template>
  <pura-button>Click me</pura-button>
</template>` },
  { label: "Astro", lang: "astro", code: `---
import "pura";
---
<pura-button>Click me</pura-button>` },
  { label: "HTML", lang: "html", code: `<script type="module" src="pura.js"></` + `script>

<pura-button>Click me</pura-button>` },
];
---

<Doc title="Introduction" layout="full">
  <pura-scroll-progress height="3px"></pura-scroll-progress>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-copy">
      <pura-badge variant="info" dot data-i18n="home.badge">Agent-native components</pura-badge>
      <h1 data-i18n-html="home.h1">Native components for the <span>agent-readable</span> web.</h1>
      <p data-i18n="home.sub">Pura is a zero-dependency, zero-build component library built on Web Components. Framework-agnostic, accessible by default, and readable by humans and agents.</p>
      <div class="cta">
        <pura-button onclick={`location.href='${withBase("/docs/button")}'`} data-i18n="home.cta.start">Get started</pura-button>
        <pura-button variant="secondary" onclick="document.getElementById('showcase').scrollIntoView({behavior:'smooth'})" data-i18n="home.cta.view">View components</pura-button>
      </div>
    </div>
    <div class="hero-demo">
      <pura-code-block language="html" filename="index.html">{heroCode}</pura-code-block>
      <div class="live">
        <span class="live-label" data-i18n="home.live">Live, no build:</span>
        <div class="live-row">
          <pura-button size="sm">Get started</pura-button>
          <pura-switch checked aria-label="Toggle"></pura-switch>
          <pura-badge variant="success" dot data-i18n="home.live.badge">Live</pura-badge>
          <pura-sparkline values="6,10,8,14,11,18,15,21" style="width:80px;height:28px" color="var(--pura-primary)"></pura-sparkline>
        </div>
      </div>
    </div>
  </section>

  <!-- STAT BAND -->
  <section class="stats">
    <pura-reveal animation="slide-up" delay="0" once><pura-stat value={`${total}+`} data-i18n-label="home.stat.components"></pura-stat></pura-reveal>
    <pura-reveal animation="slide-up" delay="80" once><pura-stat value="0" data-i18n-label="home.stat.deps"></pura-stat></pura-reveal>
    <pura-reveal animation="slide-up" delay="160" once><pura-stat value="0" data-i18n-label="home.stat.build"></pura-stat></pura-reveal>
    <pura-reveal animation="slide-up" delay="240" once><pura-stat value="5" data-i18n-label="home.stat.langs"></pura-stat></pura-reveal>
  </section>

  <!-- WHY PURA -->
  <section class="why">
    <div class="section-head">
      <h2 data-i18n="home.why.h">Web standards, not a framework</h2>
      <p data-i18n="home.why.sub">Everything below ships in the box. No plugins, no peer deps.</p>
    </div>
    <div class="feature-grid">
      {features.map((f, i) => (
        <pura-reveal animation="slide-up" delay={i * 70} once>
          <pura-card>
            <div class="ficon"><pura-icon d={f.d} size="22"></pura-icon></div>
            <strong data-i18n={`home.${f.key}.t`}></strong>
            <span data-i18n={`home.${f.key}.d`}></span>
          </pura-card>
        </pura-reveal>
      ))}
    </div>
  </section>

  <!-- WORKS ANYWHERE -->
  <section class="anywhere">
    <div class="section-head">
      <h2 data-i18n="home.anywhere.h">The same markup, anywhere</h2>
      <p data-i18n="home.anywhere.sub">One component. Every stack. No adapters, no wrappers.</p>
    </div>
    <pura-tabs active="0" class="fwtabs">
      {frameworks.map((fw) => (
        <pura-tab label={fw.label}>
          <pura-code-block language={fw.lang} filename={`App.${fw.lang}`}>{fw.code}</pura-code-block>
        </pura-tab>
      ))}
    </pura-tabs>
  </section>

  <!-- SHOWCASE -->
  <section class="showcase" id="showcase">
    <div class="section-head">
      <h2 data-i18n-html="home.showcase.h">{total} components, ready to use</h2>
      <p data-i18n="home.showcase.sub">Charts, calendars, ratings, progress and far more, all native.</p>
    </div>
    <div class="show-grid">
      <pura-reveal animation="slide-up" delay="0" once>
        <pura-card>
          <div class="row between"><strong data-i18n="home.sc.analytics">Analytics</strong><pura-badge variant="success" dot>+10%</pura-badge></div>
          <span class="sub" data-i18n="home.sc.visitors">418.2K visitors</span>
          <pura-sparkline values="12,9,14,11,16,13,19,15,21" style="width:100%;height:64px"></pura-sparkline>
          <pura-rating value="4" max="5" readonly></pura-rating>
        </pura-card>
      </pura-reveal>
      <pura-reveal animation="slide-up" delay="90" once>
        <pura-card>
          <strong data-i18n="home.sc.calendar">Pick a date</strong>
          <pura-calendar value="2026-06-20" month="2026-06"></pura-calendar>
        </pura-card>
      </pura-reveal>
      <pura-reveal animation="slide-up" delay="180" once>
        <pura-card class="center">
          <pura-progress-ring value="72" size="92"></pura-progress-ring>
          <strong data-i18n="home.sc.storage">Storage used</strong>
          <span class="sub" data-i18n="home.sc.storage.sub">7.2 GB of 10 GB</span>
        </pura-card>
      </pura-reveal>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="closing">
    <h2 data-i18n="home.close.h">No framework lock-in. No build step. No dependency tree.</h2>
    <p data-i18n="home.close.p">Just native components that work anywhere.</p>
    <div class="cta">
      <pura-button onclick={`location.href='${withBase("/docs/button")}'`} data-i18n="home.cta.start">Get started</pura-button>
      <pura-button variant="secondary" onclick="document.getElementById('showcase').scrollIntoView({behavior:'smooth'})" data-i18n="home.cta.view">View components</pura-button>
    </div>
  </section>

  <script is:inline define:vars={{ total }}>
    window.__i18nExtra = Object.assign(window.__i18nExtra || {}, {
      "home.badge": { en: "Agent-native components", "pt-BR": "Componentes agent-native", fr: "Composants agent-native", de: "Agent-native Komponenten", it: "Componenti agent-native" },
      "home.h1": { en: "Native components for the <span>agent-readable</span> web.", "pt-BR": "Componentes nativos para a web <span>legível por agentes</span>.", fr: "Des composants natifs pour le web <span>lisible par les agents</span>.", de: "Native Komponenten für das <span>agent-lesbare</span> Web.", it: "Componenti nativi per il web <span>leggibile dagli agenti</span>." },
      "home.sub": { en: "Pura is a zero-dependency, zero-build component library built on Web Components. Framework-agnostic, accessible by default, and readable by humans and agents.", "pt-BR": "Pura é uma biblioteca de componentes sem dependências e sem build, feita sobre Web Components. Agnóstica de framework, acessível por padrão e legível por humanos e agentes.", fr: "Pura est une bibliothèque de composants sans dépendance ni build, bâtie sur les Web Components. Agnostique au framework, accessible par défaut et lisible par les humains comme par les agents.", de: "Pura ist eine Komponentenbibliothek ohne Abhängigkeiten und ohne Build, gebaut auf Web Components. Framework-unabhängig, von Haus aus barrierefrei und lesbar für Menschen und Agenten.", it: "Pura è una libreria di componenti senza dipendenze e senza build, costruita su Web Components. Agnostica rispetto al framework, accessibile di default e leggibile da umani e agenti." },
      "home.cta.start": { en: "Get started", "pt-BR": "Começar", fr: "Commencer", de: "Loslegen", it: "Inizia" },
      "home.cta.view": { en: "View components", "pt-BR": "Ver componentes", fr: "Voir les composants", de: "Komponenten ansehen", it: "Vedi i componenti" },
      "home.live": { en: "Live, no build:", "pt-BR": "Ao vivo, sem build:", fr: "En direct, sans build :", de: "Live, ohne Build:", it: "Dal vivo, senza build:" },
      "home.live.badge": { en: "Live", "pt-BR": "Ao vivo", fr: "En direct", de: "Live", it: "Live" },
      "home.stat.components": { en: "Components", "pt-BR": "Componentes", fr: "Composants", de: "Komponenten", it: "Componenti" },
      "home.stat.deps": { en: "Dependencies", "pt-BR": "Dependências", fr: "Dépendances", de: "Abhängigkeiten", it: "Dipendenze" },
      "home.stat.build": { en: "Build step", "pt-BR": "Etapa de build", fr: "Étape de build", de: "Build-Schritt", it: "Fase di build" },
      "home.stat.langs": { en: "Languages", "pt-BR": "Idiomas", fr: "Langues", de: "Sprachen", it: "Lingue" },
      "home.why.h": { en: "Web standards, not a framework", "pt-BR": "Padrões da web, não um framework", fr: "Les standards du web, pas un framework", de: "Web-Standards, kein Framework", it: "Standard del web, non un framework" },
      "home.why.sub": { en: "Everything below ships in the box. No plugins, no peer deps.", "pt-BR": "Tudo abaixo já vem na caixa. Sem plugins, sem peer deps.", fr: "Tout ce qui suit est inclus. Sans plugins, sans peer deps.", de: "Alles unten ist von Haus aus dabei. Keine Plugins, keine Peer-Deps.", it: "Tutto qui sotto è incluso. Niente plugin, niente peer deps." },
      "home.f1.t": { en: "Native Web Components", "pt-BR": "Web Components nativos", fr: "Web Components natifs", de: "Native Web Components", it: "Web Components nativi" },
      "home.f1.d": { en: "Custom Elements + Shadow DOM. Works in React, Vue, Svelte or plain HTML.", "pt-BR": "Custom Elements + Shadow DOM. Funciona em React, Vue, Svelte ou HTML puro.", fr: "Custom Elements + Shadow DOM. Fonctionne avec React, Vue, Svelte ou du HTML pur.", de: "Custom Elements + Shadow DOM. Läuft in React, Vue, Svelte oder reinem HTML.", it: "Custom Elements + Shadow DOM. Funziona in React, Vue, Svelte o HTML puro." },
      "home.f2.t": { en: "Zero dependencies, zero build", "pt-BR": "Zero dependências, zero build", fr: "Zéro dépendance, zéro build", de: "Keine Abhängigkeiten, kein Build", it: "Zero dipendenze, zero build" },
      "home.f2.d": { en: "Just a script tag. No bundler, no framework lock-in.", "pt-BR": "Só uma tag de script. Sem bundler, sem lock-in de framework.", fr: "Une simple balise script. Sans bundler, sans lock-in de framework.", de: "Nur ein Script-Tag. Kein Bundler, kein Framework-Lock-in.", it: "Solo un tag script. Niente bundler, niente lock-in di framework." },
      "home.f3.t": { en: "Theme system", "pt-BR": "Sistema de temas", fr: "Système de thèmes", de: "Theme-System", it: "Sistema di temi" },
      "home.f3.d": { en: "57 brand presets + a full token editor. Restyle everything live.", "pt-BR": "57 presets de marca + editor de tokens completo. Re-estilize tudo ao vivo.", fr: "57 préréglages de marque + un éditeur de tokens complet. Restylez tout en direct.", de: "57 Marken-Presets + ein voller Token-Editor. Alles live umgestalten.", it: "57 preset di brand + un editor di token completo. Ristila tutto dal vivo." },
      "home.f4.t": { en: "Built-in i18n", "pt-BR": "i18n nativo", fr: "i18n intégré", de: "Eingebautes i18n", it: "i18n integrato" },
      "home.f4.d": { en: "Every component ships 5 languages. Switch live.", "pt-BR": "Cada componente vem com 5 idiomas. Troque ao vivo.", fr: "Chaque composant embarque 5 langues. Changez en direct.", de: "Jede Komponente bringt 5 Sprachen mit. Live umschalten.", it: "Ogni componente include 5 lingue. Cambia dal vivo." },
      "home.f5.t": { en: "Agent-native", "pt-BR": "Agent-native", fr: "Agent-native", de: "Agent-native", it: "Agent-native" },
      "home.f5.d": { en: "Machine-readable affordances so AI agents can read and operate the UI.", "pt-BR": "Affordances legíveis por máquina para agentes de IA lerem e operarem a UI.", fr: "Des affordances lisibles par machine pour que les agents IA lisent et pilotent l'UI.", de: "Maschinenlesbare Affordances, damit KI-Agenten die UI lesen und bedienen können.", it: "Affordance leggibili dalle macchine così gli agenti IA leggono e operano la UI." },
      "home.f6.t": { en: "Live inspector", "pt-BR": "Inspetor ao vivo", fr: "Inspecteur en direct", de: "Live-Inspektor", it: "Ispettore dal vivo" },
      "home.f6.d": { en: "Hover, highlight and edit any element's attributes in place.", "pt-BR": "Passe o mouse, destaque e edite os atributos de qualquer elemento ali mesmo.", fr: "Survolez, surlignez et modifiez les attributs de n'importe quel élément sur place.", de: "Beliebige Element-Attribute direkt hovern, hervorheben und bearbeiten.", it: "Passa sopra, evidenzia e modifica gli attributi di qualsiasi elemento sul posto." },
      "home.anywhere.h": { en: "The same markup, anywhere", "pt-BR": "O mesmo markup, em qualquer lugar", fr: "Le même markup, partout", de: "Dasselbe Markup, überall", it: "Lo stesso markup, ovunque" },
      "home.anywhere.sub": { en: "One component. Every stack. No adapters, no wrappers.", "pt-BR": "Um componente. Toda stack. Sem adapters, sem wrappers.", fr: "Un composant. Toutes les stacks. Sans adaptateurs ni wrappers.", de: "Eine Komponente. Jeder Stack. Keine Adapter, keine Wrapper.", it: "Un componente. Ogni stack. Niente adapter, niente wrapper." },
      "home.showcase.h": { en: total + " components, ready to use", "pt-BR": total + " componentes, prontos para usar", fr: total + " composants, prêts à l'emploi", de: total + " Komponenten, einsatzbereit", it: total + " componenti, pronti all'uso" },
      "home.showcase.sub": { en: "Charts, calendars, ratings, progress and far more, all native.", "pt-BR": "Gráficos, calendários, avaliações, progresso e muito mais, tudo nativo.", fr: "Graphiques, calendriers, notations, progression et bien plus, le tout natif.", de: "Charts, Kalender, Bewertungen, Fortschritt und vieles mehr, alles nativ.", it: "Grafici, calendari, valutazioni, progressi e molto altro, tutto nativo." },
      "home.sc.analytics": { en: "Analytics", "pt-BR": "Análises", fr: "Analytique", de: "Analytik", it: "Analisi" },
      "home.sc.visitors": { en: "418.2K visitors", "pt-BR": "418,2 mil visitantes", fr: "418,2 K visiteurs", de: "418,2 Tsd. Besucher", it: "418,2 mila visitatori" },
      "home.sc.calendar": { en: "Pick a date", "pt-BR": "Escolha uma data", fr: "Choisir une date", de: "Datum wählen", it: "Scegli una data" },
      "home.sc.storage": { en: "Storage used", "pt-BR": "Armazenamento usado", fr: "Stockage utilisé", de: "Belegter Speicher", it: "Spazio utilizzato" },
      "home.sc.storage.sub": { en: "7.2 GB of 10 GB", "pt-BR": "7,2 GB de 10 GB", fr: "7,2 Go sur 10 Go", de: "7,2 GB von 10 GB", it: "7,2 GB di 10 GB" },
      "home.close.h": { en: "No framework lock-in. No build step. No dependency tree.", "pt-BR": "Sem lock-in de framework. Sem build. Sem árvore de dependências.", fr: "Sans lock-in de framework. Sans build. Sans arbre de dépendances.", de: "Kein Framework-Lock-in. Kein Build. Kein Abhängigkeitsbaum.", it: "Niente lock-in di framework. Niente build. Niente albero di dipendenze." },
      "home.close.p": { en: "Just native components that work anywhere.", "pt-BR": "Apenas componentes nativos que funcionam em qualquer lugar.", fr: "Juste des composants natifs qui fonctionnent partout.", de: "Einfach native Komponenten, die überall laufen.", it: "Solo componenti nativi che funzionano ovunque." },
    });

    // Localize attribute-based labels (pura-stat label) on load + locale switch.
    const D = () => Object.assign({}, window.__i18nExtra || {});
    const applyAttrs = (loc) => {
      const dict = D();
      document.querySelectorAll("[data-i18n-label]").forEach((el) => {
        const e = dict[el.dataset.i18nLabel];
        if (e) el.setAttribute("label", e[loc] || e.en);
      });
    };
    const cur = localStorage.getItem("pura-locale") || "en";
    applyAttrs(cur);
    addEventListener("pura:locale", (e) => applyAttrs(e.detail.locale));
    if (cur !== "en" && window.__applyChrome) window.__applyChrome(cur);
  </script>
</Doc>

<style>
  /* HERO */
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 3rem; align-items: center;
    max-width: 1120px; margin: 0 auto; padding: 4.5rem 1.5rem 3rem; }
  .hero-copy h1 { font-size: clamp(2.3rem, 5vw, 3.4rem); line-height: 1.05; letter-spacing: -.04em;
    margin: 1.1rem 0 0; font-weight: 750; }
  .hero-copy h1 span { background: linear-gradient(120deg, var(--pura-primary), color-mix(in oklab, var(--pura-primary) 35%, #8b5cf6), var(--pura-primary));
    background-size: 220% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    animation: shimmer 6s ease-in-out infinite; }
  @keyframes shimmer { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  .hero-copy p { font-size: 1.12rem; color: var(--pura-muted-fg); line-height: 1.6; margin: 1.25rem 0 0; max-width: 52ch; }
  .cta { display: flex; gap: .75rem; margin-top: 1.85rem; flex-wrap: wrap; }
  .closing .cta { justify-content: center; }

  /* hero entrance */
  .hero-copy > *, .hero-demo { animation: fade-up .6s cubic-bezier(.22,.61,.36,1) both; }
  .hero-copy pura-badge { animation-delay: .02s; }
  .hero-copy h1 { animation-delay: .08s; }
  .hero-copy p { animation-delay: .16s; }
  .hero-copy .cta { animation-delay: .24s; }
  .hero-demo { animation-delay: .3s; }
  @keyframes fade-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .hero-demo { display: flex; flex-direction: column; gap: .85rem; }
  .hero-demo pura-code-block { display: block; }
  .live { border: 1px solid var(--pura-border); border-radius: var(--pura-radius-lg);
    padding: .85rem 1rem; background: var(--pura-bg); box-shadow: var(--pura-shadow-sm); }
  .live-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--pura-muted); }
  .live-row { display: flex; gap: .65rem; align-items: center; flex-wrap: wrap; margin-top: .6rem; }

  /* STAT BAND */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; max-width: 980px;
    margin: 1rem auto; padding: 1.5rem; border: 1px solid var(--pura-border);
    border-radius: var(--pura-radius-lg); background: var(--pura-subtle); }

  /* SECTION SHELL */
  .section-head { text-align: center; max-width: 620px; margin: 0 auto 2rem; }
  .section-head h2 { font-size: clamp(1.6rem, 3.5vw, 2.1rem); letter-spacing: -.03em; margin: 0; }
  .section-head p { color: var(--pura-muted-fg); line-height: 1.6; margin: .65rem 0 0; }
  .why, .anywhere, .showcase { max-width: 1120px; margin: 0 auto; padding: 4rem 1.5rem; }

  /* reveal wrappers act as the grid cell */
  .stats > pura-reveal, .feature-grid > pura-reveal, .show-grid > pura-reveal { display: block; }
  .show-grid > pura-reveal { height: 100%; }
  .show-grid > pura-reveal > pura-card { height: 100%; }

  /* hover lift on cards */
  .feature-grid pura-card, .show-grid pura-card { transition: transform .2s ease, box-shadow .2s ease; }
  .feature-grid pura-card:hover, .show-grid pura-card:hover { transform: translateY(-4px); box-shadow: var(--pura-shadow-lg, 0 12px 28px rgba(0,0,0,.12)); }

  /* FEATURE GRID */
  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .feature-grid pura-card { display: block; }
  .ficon { width: 44px; height: 44px; border-radius: var(--pura-radius); display: grid; place-items: center;
    background: color-mix(in oklab, var(--pura-primary) 12%, transparent); color: var(--pura-primary); margin-bottom: .9rem; }
  .feature-grid strong { display: block; font-size: 1rem; margin-bottom: .35rem; }
  .feature-grid span { color: var(--pura-muted-fg); font-size: .9rem; line-height: 1.5; }

  /* WORKS ANYWHERE */
  .fwtabs { display: block; max-width: 760px; margin: 0 auto; }
  .fwtabs pura-code-block { display: block; margin-top: 1rem; }

  /* SHOWCASE */
  .show-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .show-grid pura-card { display: flex; flex-direction: column; gap: .7rem; }
  .show-grid pura-card.center { align-items: center; text-align: center; justify-content: center; }
  .show-grid .sub { font-size: .82rem; color: var(--pura-muted); margin-top: -.35rem; }
  .row { display: flex; gap: .5rem; align-items: center; }
  .row.between { justify-content: space-between; }

  /* CLOSING */
  .closing { text-align: center; max-width: 660px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  .closing h2 { font-size: clamp(1.5rem, 3.5vw, 2rem); letter-spacing: -.02em; line-height: 1.2; }
  .closing p { color: var(--pura-muted-fg); font-size: 1.1rem; margin-top: .75rem; }

  @media (max-width: 900px) {
