# git worktrees
.worktrees/

# monorepo build outputs (generated into www public root by build:registry).
# Globs cover every registry root file emitted by emitRuntime() so adding a new
# registry/*.js|*.css never silently commits a generated artifact. No committed
# asset lives at the public root (only favicon.svg + templates/).
apps/www/dist/
apps/www/public/*.js
apps/www/public/*.css
apps/www/public/r/
apps/www/public/components/
apps/www/public/lib/
apps/www/public/agents.json
apps/www/public/llms.txt
registry/registry.json

# CLI user-side artifacts (when dogfooding)
.pura/

# local dev scratch (standalone registry browser + verify stubs)
/registry.html
/components/

# codemod / analysis scratch (root-level diagnostics, never committed)
/_*.mjs
/_*.txt
/_*.json
/_*.html

# astro
apps/www/.astro/

# pnpm local store
.pnpm-store/

# agent temp artifacts
_showcase.html
_proof.html
_intervar.woff2
_tmscroll.html
_dtest.html

# local screenshots / reference material
/*.png
/*.jpeg
/shots-logica/
